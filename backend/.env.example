# ─────────────────────────────────────────────────────────────
# Exemple de configuration — COPIER ce fichier vers backend/.env
# puis remplacer les valeurs par les vôtres. Ne jamais committer .env.
# ─────────────────────────────────────────────────────────────

# --- Base de données PostgreSQL (OBLIGATOIRE) ---
# Format : postgresql://UTILISATEUR:MOT_DE_PASSE@HOTE:PORT/NOM_BASE
DATABASE_URL=postgresql://veille_user:CHANGEZ_MOI@localhost:5432/veille_db

# --- Clé API Groq pour la génération du chatbot RAG (OBLIGATOIRE) ---
# À créer sur https://console.groq.com/keys
GROQ_API_KEY=votre_cle_groq_ici

# --- Clé API NewsAPI pour la collecte d'articles (OBLIGATOIRE) ---
# À créer sur https://newsapi.org/account
NEWSAPI_KEY=votre_cle_newsapi_ici

# --- URL du serveur Ollama local (optionnel, valeur par défaut ci-dessous) ---
OLLAMA_BASE_URL=http://localhost:11434

# ─────────────────────────────────────────────────────────────
# Authentification / JWT
# ─────────────────────────────────────────────────────────────
# Secret de signature des JWT. Laissez vide : un secret aléatoire fort sera
# généré automatiquement au 1er démarrage et ajouté à backend/.env.
# Pour en fixer un manuellement : python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=

# Durées d'expiration des tokens (optionnel, valeurs par défaut ci-dessous)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Compte admin créé automatiquement au démarrage ---
# Sans ces variables, aucun admin par défaut n'est créé (un avertissement est loggé).
# CHANGEZ le mot de passe ci-dessous.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGEZ_MOI

# ─────────────────────────────────────────────────────────────
# Collecte planifiée (APScheduler)
# ─────────────────────────────────────────────────────────────
# Intervalle (en heures) entre deux cycles automatiques collecte→NLP→indexation.
# Optionnel, défaut = 6.
COLLECT_INTERVAL_HOURS=6

# ─────────────────────────────────────────────────────────────
# Alertes sur articles critiques (email SMTP et/ou webhook Slack/Discord)
# ─────────────────────────────────────────────────────────────
# Canal(aux) d'envoi : "email", "slack", "both" ou "none". Défaut sûr = "none"
# (aucune alerte envoyée). Le système fonctionne même si un canal n'est pas configuré.
ALERT_CHANNEL=none

# --- Email (SMTP) ---
# Laissez SMTP_HOST vide pour désactiver l'email. Exemple Gmail ci-dessous.
# SMTP_PASSWORD doit être un "mot de passe d'application" Gmail (voir README), PAS
# votre mot de passe habituel.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# --- Webhook Slack ou Discord ---
# Laissez vide pour désactiver ce canal. Créez un "Incoming Webhook" (Slack) ou un
# webhook de salon (Discord) et collez l'URL complète ici.
SLACK_WEBHOOK_URL=
